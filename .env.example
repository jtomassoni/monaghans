# Database
DATABASE_URL=postgresql://user:password@localhost:5432/monaghans

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Authentication - Admin Users
# Format: ADMIN_USER='{"username":"admin","password":"password"}' or ADMIN_USERS='[{"username":"admin1","password":"pass1"}]'
ADMIN_USER=
ADMIN_USERS=

# Authentication - Owner Users
# Format: OWNER_USER='{"username":"owner","password":"password"}' or OWNER_USERS='[{"username":"owner1","password":"pass1"}]'
OWNER_USER=
OWNER_USERS=

# reCAPTCHA Configuration
# Get keys from: https://www.google.com/recaptcha/admin
# Keys used only when the deployment is treated as production (see lib/recaptcha-policy.ts).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Feature Flags (optional)
ENABLE_SOCIAL_POSTING=false

# Facebook/Instagram (optional - for social posting)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Vercel Cron calls GET /api/cron/facebook-food-special every hour on the production deployment
# and sends Authorization: Bearer <CRON_SECRET>. Generate with: openssl rand -base64 32
# Set the same value in Vercel → Production. If it is missing there, the cron returns 401.
CRON_SECRET=

# Who gets the "food special ready" email when the hourly Facebook check finds one.
# Comma-separated. Defaults to jtomassoni@gmail.com if unset.
FOOD_SPECIAL_NOTIFY_EMAIL=

# Reads words in a Facebook photo or story when the caption does not already parse.
# Same key as the meal planner. Add both to Vercel Production.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Resend (optional — private dining form staff notifications)
# https://resend.com
#
# RESEND_FROM must use an address @ a domain you verify in Resend (DNS). You do not need a real inbox —
# noreply@… is fine. With a display name, use plain words only (letters, numbers, spaces; no @, commas, or quotes). Example:
#   RESEND_FROM="Event Space at Monaghans <noreply@monaghansbarandgrilldenver.com>"
#
# Optional: if From is noreply@…, set Reply-To to the owner’s real inbox so “Reply” in the mail client goes there:
#   RESEND_REPLY_TO=owner@gmail.com
#
# Customer confirmation after public private-events form submit.
# Default behavior is ON when unset. Set to false to disable.
# PRIVATE_DINING_SEND_CUSTOMER_CONFIRMATION=true
#
# On Vercel Preview, add these to the Preview environment too (or they will not send).
RESEND_API_KEY=
RESEND_FROM=
# RESEND_REPLY_TO=

# Resend webhook signing secret (dashboard → Webhooks → your endpoint → Signing Secret).
# Required for verified webhooks: staff verification open tracking, AND inbound replies into the CRM.
# Webhook URL: https://<your-domain>/api/webhooks/resend
# Subscribe to at least: `email.opened`, `email.received` (inbound replies need receiving + this event).
#
# Inbound replies (e.g. customer replies to reply@yourdomain.com):
# 1. Resend → Domains → your domain → enable Receiving (add MX records they show).
# 2. Webhooks → Add → event `email.received` → same URL as above.
# 3. The app fetches full message body via Resend API (webhook payload is metadata-only).
RESEND_WEBHOOK_SECRET=

# Site URL for email links (verify links, admin deep links, food-special confirm links). Also used by NextAuth.
# - Local: http://localhost:3000
# - Vercel Preview: optional — if unset, the app uses https:// + VERCEL_URL (your *.vercel.app deployment).
# - Production: your canonical public URL. The food-special email button is built from this.
#   NEXTAUTH_URL=https://www.monaghansbarandgrilldenver.com
# Keep the existing Production NEXTAUTH_SECRET. The local placeholder must not replace it.
